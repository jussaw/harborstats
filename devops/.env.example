# Settings for backup-db.sh and restore-db.sh, read from devops/.env on the
# host that runs the app. The app's own settings (ADMIN_PASSWORD,
# ADMIN_SESSION_SECRET, ADMIN_SESSION_VERSION) belong to the compose stack that
# deploys the image, not to this file; see devops/README.md.

# Where backup-db.sh writes harborstats-<timestamp>.db files.
BACKUP_DIR=/var/backups/harborstats
# Days to keep old harborstats-*.db backups.
RETENTION_DAYS=30
# Optional. The app container both scripts work on.
# CONTAINER_NAME=harborstats-web
