ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Optional. Defaults to "1". Bump to invalidate all existing admin sessions
# (log everyone out) without rotating ADMIN_SESSION_SECRET.
ADMIN_SESSION_VERSION=1

# Fresh installs only: set to 1 for the very first start so the app may create
# an empty database, then remove it. Without it the app refuses to start on a
# missing or empty database, so a wrong volume never serves an empty site.
# DATABASE_ALLOW_CREATE=1

# Optional backup/restore script overrides.
BACKUP_DIR=/var/backups/harborstats
RETENTION_DAYS=30
